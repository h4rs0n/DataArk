DATAARK_PORT=7845
ARCHIVE_LOCATION=/archive/
LOG_RETENTION_DAYS=7

MEILI_HOST=http://meili:7700
MEILI_MASTER_KEY=replace-with-a-random-key
MEILI_DUMP_DIR=/meili_dumps

SINGLEFILE_HOST=http://singlefile-webservice:8080
SINGLEFILE_PORT=8080
SINGLEFILE_TIMEOUT=60
SINGLEFILE_OUTPUT_DIR=/usr/src/app/output

DB_HOST=database
DB_PORT=5432
DB_NAME=echoark
DB_USER=postgres
DB_PASSWORD=replace-with-a-random-password

DISCOVERY_INTERVAL=6h
DISCOVERY_TIMEOUT=12s
DISCOVERY_MAX_CANDIDATES=50
DISCOVERY_SOCKS5_PROXY=
DISCOVERY_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/150.0.0.0 Safari/537.36

RECOMMEND_ENABLED=true

LLM_BASE_URL=
LLM_API_KEY=
LLM_CHAT_MODEL=
LLM_EMBEDDING_MODEL=
LLM_TIMEOUT=300s
EMBEDDING_DIMENSION=0
